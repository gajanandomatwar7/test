<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>S3 upload benchmark</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="brand">
        <h1>S3 upload benchmark</h1>
        <p class="pills">
          <span class="pill"><strong><%= bucket %></strong></span>
          <span class="pill"><%= endpoint %></span>
          <span class="pill">region <%= region %></span>
          <span class="pill" id="healthPill">checking endpoint…</span>
        </p>
      </div>
      <a class="ghost-btn" href="/results" target="_blank" rel="noreferrer">results.md →</a>
    </header>

    <main>
      <section class="card">
        <h2>Run settings</h2>
        <label class="field">
          <span>File sizes (comma separated, up to <%= maxSize %>)</span>
          <input
            id="sizes"
            type="text"
            value="<%= defaultSizes %>"
            spellcheck="false"
            autocomplete="off"
          />
        </label>
        <p class="hint" id="planInfo">Each size is generated on the fly as arbitrary bytes.</p>
        <p class="error-text" id="formError" hidden></p>

        <label class="check">
          <input type="checkbox" id="deleteAfter" checked />
          <span>Delete each object immediately after its upload finishes (keeps the bucket from filling up)</span>
        </label>

        <div class="actions">
          <button id="startBtn" class="primary" disabled>Start</button>
          <button id="stopBtn" class="ghost" disabled>Stop</button>
          <span class="hint">Each size is uploaded <strong><%= attempts %>×</strong>, one after another.</span>
        </div>
      </section>

      <section class="card live" id="liveCard">
        <div class="live-top">
          <div>
            <p class="eyebrow" id="liveEyebrow">Idle</p>
            <h2 id="liveTitle">Waiting to start</h2>
            <p class="hint mono" id="liveSub">Press Start to begin uploading.</p>
          </div>
          <div class="timer">
            <span id="liveTimer">0.000</span><span class="unit">s</span>
            <p class="hint" id="liveSpeed">—</p>
          </div>
        </div>
        <div class="bar"><div class="bar-fill" id="liveBar"></div></div>
        <div class="live-foot">
          <span id="liveBytes">—</span>
          <span id="liveParts"></span>
        </div>
      </section>

      <section class="card">
        <div class="card-head">
          <h2>This run</h2>
          <span class="hint" id="runProgress">No uploads yet</span>
        </div>
        <div class="table-wrap">
          <table id="resultsTable">
            <thead>
              <tr>
                <th class="num">#</th>
                <th>Size</th>
                <th class="num">Attempt</th>
                <th class="num">Duration (s)</th>
                <th class="num">Throughput</th>
                <th>Status</th>
                <th>Object key</th>
              </tr>
            </thead>
            <tbody id="resultsBody">
              <tr class="empty"><td colspan="7">Results appear here as each upload finishes.</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="card">
        <div class="card-head">
          <h2>Log</h2>
          <button class="ghost-btn" id="clearLog" type="button">clear</button>
        </div>
        <pre id="log" class="log"></pre>
      </section>
    </main>

    <script src="/app.js"></script>
  </body>
</html>
